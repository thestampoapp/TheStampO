cat > .gitignore <<'EOF'
node_modules/
.expo/
.expo-shared/
dist/
web-build/
.cache/
.npm/
.tmp/
.parcel-cache/
*.zip
android/
ios/
.gradle/
**/build/
android/captures/
android/local.properties
*.iml
.idea/
*.jks
*.keystore
.env
.env.*
!.env.example
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
log.txt
.DS_Store
Thumbs.db
*.swp
.vscode/
EOF