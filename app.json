{
  "expo": {
    "name": "TheStampO",
    "slug": "thestampo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.kunatic.thestampo",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF8F4"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_SMS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "extraProguardRules": "-keep class com.google.android.gms.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep class com.google.firebase.** { *; }\n-keep class io.invertase.firebase.** { *; }\n-keep class io.invertase.googlemobileads.** { *; }\n-dontwarn com.google.android.gms.**\n-dontwarn com.google.firebase.**\n"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TheStampO uses your camera to punch photos into stamps.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TheStampO needs your photos so you can turn one into a stamp."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TheStampO tags a stamp with where you were, only when you tap the location button.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9787924287473838~1465716759"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TheStampO saves your stamps to your gallery.",
          "savePhotosPermission": "TheStampO saves your stamps to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "860f1c3c-7b76-4d87-9bec-095de01c8d75"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "owner": "thestampo"
  }
}